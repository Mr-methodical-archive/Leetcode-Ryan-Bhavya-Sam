class Solution {
public: // 
    vector<int> twoSum(vector<int>& nums, int target) { // array is returned
        // must add up to target (we can do in O(n^2) easy by going through each element and checking if add up to element)
        for (int i = 0; i < nums.size(); ++i) {
            for (int j = i + 1; j < nums.size(); ++j) {
                if (nums[i] + nums[j] == target) {
                    return {i, j};
                }
            }
        }
        return {0, 0};
    }
};
